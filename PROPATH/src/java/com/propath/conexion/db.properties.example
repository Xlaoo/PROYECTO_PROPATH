# ==============================================================================
# PROPATH - Plantilla de Configuración JDBC
# ==============================================================================
# Copie este archivo como 'db.properties' y configure sus credenciales locales.
# NUNCA suba contraseñas reales al repositorio de control de versiones.
# ==============================================================================
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/propath_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=propath_user
db.password=CONFIGURAR_CONTRASENA_AQUI

